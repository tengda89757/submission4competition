\newcommand{\ReportFrontMatter}{%
  \pagenumbering{roman}
  \setcounter{page}{1}
  \chapter*{Document control}
  \addcontentsline{toc}{chapter}{Document control}
  \begin{tblr}{
    width=\linewidth,
    colspec={Q[l,0.9] Q[l,2.4]},
    row{odd}={bg=ReportMist},
    hlines={0.35pt,ReportRule},
    vlines={0.25pt,ReportRule},
    column{1}={font=\sffamily\bfseries\color{ReportNavy}},
    cells={font=\small,valign=m},
    colsep=4pt,rowsep=4pt
  }
    Document & JCIIOT 2026 RunningRobot Technical Report \\
    Team & BIPT-EDU \\
    Revision & 2.0 --- professional LaTeX edition \\
    Evidence freeze & Submitted L1--L5 executions listed in \CodeInline{results/final\_run\_summary.json} \\
    Result & 100/100; five realism audits \PASS; five full-frame videos \PASS \\
    Scope & Fixed official simulator scenes; claims are bounded by \cref{chap:limitations} \\
  \end{tblr}

  \begin{EvidenceBox}[title={Evidence and claim discipline}]
  All quantitative results are generated from the frozen submitted trajectories and their associated score, realism-audit, and video-verification records. Objective score and realism evidence are conjunctive release gates. The report does not claim unseen-scene generalization or real-robot safety.
  \end{EvidenceBox}

